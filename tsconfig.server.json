{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist/server"
  },
  "include": ["server", "shared"],
  "exclude": ["server/**/*.test.ts", "server/testing"]
}
